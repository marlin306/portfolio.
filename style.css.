
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #263044;
    background-color: #ffffff;
    line-height: 1.7;
}

a {
    text-decoration: none;
}

header {
    background-color: #172554;
    padding: 18px 8%;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.logo {
    color: #ffffff;
    font-size: 27px;
    font-weight: bold;
}

.navbar ul {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
}

.navbar ul a {
    color: #ffffff;
    font-size: 14px;
}

.navbar ul a:hover {
    color: #93c5fd;
}

.hero {
    min-height: 430px;
    padding: 100px 8%;
    text-align: center;
    background: linear-gradient(135deg, #eff6ff, #e0e7ff);
}

.intro {
    color: #4f46e5;
    font-weight: bold;
    letter-spacing: 2px;
    font-size: 13px;
}

.hero h1 {
    margin: 12px 0;
    font-size: 42px;
}

.hero h1 span {
    color: #4f46e5;
}

.hero h2 {
    margin-bottom: 15px;
    font-size: 22px;
}

.hero p {
    max-width: 600px;
    margin: 0 auto 22px;
}

.button {
    display: inline-block;
    background-color: #4f46e5;
    color: white;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: bold;
    transition: 0.3s;
}

.button:hover {
    background-color: #312e81;
    transform: translateY(-3px);
}

.section {
    padding: 65px 8%;
    text-align: center;
}

.section h2 {
    font-size: 30px;
}

.underline {
    width: 60px;
    height: 4px;
    background-color: #4f46e5;
    margin: 12px auto 25px;
    border-radius: 4px;
}

.section > p {
    max-width: 760px;
    margin: 0 auto;
}

.alternate {
    background-color: #f5f7ff;
}

.section-intro {
    margin-bottom: 28px !important;
}

.skills-grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
    max-width: 800px;
    margin: 25px auto 0;
}

.skill {
    background-color: white;
    color: #3730a3;
    border: 1px solid #c7d2fe;
    padding: 12px 22px;
    border-radius: 8px;
    font-weight: bold;
    transition: 0.3s;
}

.skill:hover {
    background-color: #4f46e5;
    color: white;
    transform: translateY(-3px);
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    margin-top: 30px;
    text-align: left;
}

.project-card {
    padding: 25px;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 4px 12px rgba(23, 37, 84, 0.07);
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(23, 37, 84, 0.12);
}

.project-card h3 {
    color: #312e81;
    margin-bottom: 10px;
}

.project-card span {
    display: inline-block;
    margin-top: 15px;
    color: #4f46e5;
    font-size: 13px;
    font-weight: bold;
}

.contact-note {
    margin-top: 12px !important;
}

footer {
    background-color: #172554;
    color: #ffffff;
    text-align: center;
    padding: 22px 10px;
    font-size: 14px;
}

@media (max-width: 600px) {
    .navbar {
        flex-direction: column;
    }

    .navbar ul {
        justify-content: center;
        gap: 12px;
    }

    .hero {
        padding: 70px 6%;
    }

    .hero h1 {
        font-size: 32px;
    }

    .section {
        padding: 45px 6%;
    }
}
